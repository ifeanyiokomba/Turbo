// Turbopay — Prisma schema (SQLite adaptation)
// Money stored as Integer kobo (1 NGN = 100 kobo).
// SQLite has no native enums => use String + app-level validation constants.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  fullName           String
  username           String   @unique
  email              String?  @unique
  phone              String?  @unique
  country            String   @default("NG")
  passwordHash       String
  transactionPinHash String?
  pinSetAt           DateTime?
  pinFailCount       Int      @default(0)
  pinLockedUntil     DateTime?
  loginFailCount     Int      @default(0)
  loginLockedUntil   DateTime?
  kycTier            Int      @default(1) // 1 | 2 | 3
  kycStatus          String   @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED
  bvn                String?
  nin                String?
  status             String   @default("ACTIVE") // ACTIVE | FROZEN | SUSPENDED | CLOSED
  emailVerified      Boolean  @default(false)
  phoneVerified      Boolean  @default(false)
  avatarUrl          String?
  bio                String?
  role               String   @default("USER") // USER | ADMIN
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions           Session[]
  wallet             Wallet?
  transactions       Transaction[]
  ledgerEntries      LedgerEntry[]
  virtualAccounts    VirtualAccount[]
  virtualCards       VirtualCard[]
  beneficiaries      Beneficiary[]
  billPayments       BillPayment[]
  airtimePurchases   AirtimeDataPurchase[]
  savingsTx          SavingsTransaction[]
  autoSaveRules      AutoSaveRule[]
  investments        UserInvestment[]
  kycVerifications   KycVerification[]
  auditLogs          AuditLog[]
  amlFlags           AmlFlag[]
  notifications      InAppNotification[]
  supportTickets     SupportTicket[]
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String   @unique
  expiresAt       DateTime
  userAgent       String?
  ip              String?
  createdAt       DateTime @default(now())
  revokedAt       DateTime?

  @@index([userId])
}

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceKobo  Int      @default(0)
  currency     String   @default("NGN")
  status       String   @default("ACTIVE") // ACTIVE | FROZEN
  version      Int      @default(0) // optimistic concurrency
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ledgerEntries LedgerEntry[]
  transactions  Transaction[]
}

model LedgerEntry {
  id              String   @id @default(cuid())
  walletId        String
  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryType       String // DEBIT | CREDIT
  amountKobo      Int
  currency        String   @default("NGN")
  refType         String // FUNDING | TRANSFER | AIRTIME | DATA | BILL | REVERSAL | FEE | CARD_FUND | CARD_WITHDRAW | REWARD | REFERRAL | SAVINGS | INVESTMENT
  refId           String?
  pairId          String?
  balanceAfterKobo Int
  description     String
  createdAt       DateTime @default(now())

  @@index([walletId])
  @@index([userId, createdAt])
  @@index([refType, refId])
}

model Transaction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId        String?
  wallet          Wallet?  @relation(fields: [walletId], references: [id])
  reference       String   @unique
  type            String // FUNDING | TRANSFER | AIRTIME | DATA | BILL | CARD_FUND | CARD_WITHDRAW | REWARD | REFERRAL | SAVINGS_DEPOSIT | SAVINGS_WITHDRAW | INVESTMENT
  direction       String // CREDIT | DEBIT
  amountKobo      Int
  feeKobo         Int      @default(0)
  status          String   @default("PENDING") // PENDING | SUCCESS | FAILED | REVERSED
  state           String   @default("INITIATED") // INITIATED | PIN_VERIFIED | SETTLED | REVERSED
  counterpartyName String?
  counterpartyAccount String?
  counterpartyBank   String?
  description     String?
  provider        String?
  providerRef     String?
  reversalOfId    String?
  metadata        String? // JSON string
  note            String? // user-added note/tag
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([type])
  @@index([status])
}

model VirtualAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountNumber String   @unique
  accountName   String
  bankName      String   @default("Turbopay MFB")
  bankCode      String   @default("000")
  provider      String   @default("turbopay")
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
}

model Beneficiary {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  accountNumber String
  bankName      String
  bankCode      String?
  type          String   @default("BANK") // BANK | TURBOPAY
  isFavorite    Boolean  @default(false)
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model BillPayment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String // ELECTRICITY | INTERNET | CABLE | WATER | EDUCATION | INSURANCE | GOVERNMENT | BETTING
  billerName    String
  billerCode    String
  customerRef   String
  amountKobo    Int
  status        String   @default("SUCCESS")
  reference     String   @unique
  token         String? // electricity token
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([category])
}

model AirtimeDataPurchase {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // AIRTIME | DATA
  network       String // MTN | GLO | AIRTEL | NMOBILE
  phone         String
  amountKobo    Int
  planName      String?
  status        String   @default("SUCCESS")
  reference     String   @unique
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model VirtualCard {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  panMasked     String // last4 stored as "•••• 4242"
  last4         String
  panEnc        String // AES-encrypted full PAN (demo key)
  cvvEnc        String
  expiry        String // MM/YY
  cardholder    String
  brand         String   @default("VISA") // VISA | MASTERCARD
  balanceKobo   Int      @default(0)
  status        String   @default("ACTIVE") // ACTIVE | FROZEN | TERMINATED
  spendingLimitKobo Int @default(500000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions  VirtualCardTransaction[]

  @@index([userId])
}

model VirtualCardTransaction {
  id            String   @id @default(cuid())
  cardId        String
  card          VirtualCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId        String
  type          String // FUND | WITHDRAW | PAYMENT
  amountKobo    Int
  description   String
  status        String   @default("SUCCESS")
  reference     String   @unique
  createdAt     DateTime @default(now())

  @@index([cardId, createdAt])
}

model SavingsProduct {
  id            String   @id @default(cuid())
  name          String
  type          String // FLEXIBLE | LOCKED | TARGET | GOAL
  interestBps   Int // basis points per annum
  minAmountKobo Int      @default(1000)
  lockDays      Int      @default(0)
  description   String?
  createdAt      DateTime @default(now())
  transactions  SavingsTransaction[]
  autoSaveRules AutoSaveRule[]
}

model SavingsTransaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       SavingsProduct @relation(fields: [productId], references: [id])
  type          String // DEPOSIT | WITHDRAW | INTEREST
  amountKobo    Int
  balanceAfterKobo Int
  status        String   @default("SUCCESS")
  reference     String   @unique
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// Auto-save rule — user-configured rule that sweeps spare change or a fixed
// amount into a savings product automatically.
//   type       = ROUND_UP | PERCENTAGE | FIXED
//   amountKobo = for FIXED the per-run amount; for ROUND_UP the rounding unit
//                (100/500/1000 kobo-of-NGN = ₦1/₦5/₦10); for PERCENTAGE
//                the percent (e.g. 5 = 5%).
model AutoSaveRule {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // ROUND_UP | PERCENTAGE | FIXED
  amountKobo     Int
  productId      String
  product        SavingsProduct @relation(fields: [productId], references: [id])
  enabled        Boolean  @default(true)
  totalSavedKobo Int      @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([userId, enabled])
}

model SavingsGoal {
  id            String   @id @default(cuid())
  userId        String
  name          String
  targetKobo    Int
  currentKobo   Int      @default(0)
  targetDate    DateTime?
  color         String   @default("emerald")
  icon          String   @default("Target")
  status        String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contributions SavingsGoalContribution[]
  @@index([userId, status])
}

model SavingsGoalContribution {
  id            String   @id @default(cuid())
  goalId        String
  goal          SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId        String
  amountKobo    Int
  type          String   @default("DEPOSIT") // DEPOSIT | WITHDRAW
  reference     String   @unique
  createdAt     DateTime @default(now())
  @@index([goalId, createdAt])
}

model InvestmentProduct {
  id            String   @id @default(cuid())
  name          String
  type          String // FIXED_INCOME | MUTUAL_FUND | TBILL | BOND
  riskLevel     String   @default("LOW") // LOW | MEDIUM | HIGH
  minAmountKobo Int
  maxAmountKobo Int
  expectedReturnBps Int
  durationLabel String // "30 days", "6 months"
  provider      String
  createdAt      DateTime @default(now())
  investments    UserInvestment[]
}

model UserInvestment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       InvestmentProduct @relation(fields: [productId], references: [id])
  principalKobo Int
  currentValueKobo Int
  status        String   @default("ACTIVE") // ACTIVE | MATURED | LIQUIDATED
  maturityAt    DateTime
  createdAt     DateTime @default(now())

  @@index([userId])
}

model KycVerification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier          Int // 2 | 3
  status        String   @default("PENDING")
  provider      String   @default("turbopay")
  nin           String?
  bvn           String?
  payload       String? // JSON audit
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String
  category      String // AUTH | WALLET | TRANSFER | BILL | KYC | AML | ADMIN
  severity      String   @default("INFO") // INFO | WARN | ERROR | CRITICAL
  ip            String?
  userAgent     String?
  metadata      String? // JSON
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([category])
}

model AmlFlag {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule          String // VELOCITY | LARGE_AMOUNT | RAPID_TRANSFER
  severity      String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  description   String
  metadata      String?
  resolved      Boolean  @default(false)
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model IdempotencyRecord {
  id            String   @id @default(cuid())
  key           String   @unique
  userId        String?
  endpoint      String
  requestBody   String?
  responseBody  String?
  status        Int
  completedAt   DateTime?
  createdAt     DateTime @default(now())
}

model InAppNotification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // TRANSACTION | SECURITY | KYC | REWARD | SYSTEM
  title         String
  body          String
  priority      String   @default("NORMAL") // LOW | NORMAL | HIGH
  read          Boolean  @default(false)
  actionUrl     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model SupportTicket {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       String
  category      String
  priority      String   @default("NORMAL")
  status        String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  message       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model KycTierLimit {
  id            Int      @id
  tier          Int      @unique
  label         String
  singleTxLimitKobo  Int
  dailyLimitKobo     Int
  maxBalanceKobo     Int
}

// ===== TurboCore Provider Platform Layer (31 new models) =====
// All money in minor units (kobo/cents) as Int. SQLite has no enums => String + app constants.

// --- Provider system ---
model ProviderConfig {
  code          String   @id // "paystack" | "flutterwave" | "monnify" | "mpesa" | "wise" | ...
  displayName   String
  sandbox       Boolean  @default(true)
  enabled       Boolean  @default(true)
  weightsJSON   String   @default("{}") // routing weights: {capability:0.4,health:0.3,cost:0.2,settle:0.1}
  defaultPriority Int    @default(50)
  website       String?
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProviderCredentialVersion {
  id            String   @id @default(cuid())
  providerCode  String
  version       Int
  secretsEnc    String // AES-256-GCM encrypted JSON of secrets
  activatedAt   DateTime @default(now())
  rotatedAt     DateTime?
  rotatedBy     String?
  active        Boolean  @default(true)
  @@unique([providerCode, version])
  @@index([providerCode, active])
}

model ProviderRoute {
  id            String   @id @default(cuid())
  contract      String // ContractName
  providerCode  String
  country       String // ISO alpha-2 or "ALL"
  currency      String // ISO 4217 or "ALL"
  priority      Int      @default(50)
  weight        Int      @default(100)
  canaryPercent Int      @default(100)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([contract, country, currency, enabled])
}

model ProviderHealthCheck {
  id            String   @id @default(cuid())
  providerCode  String
  ok            Boolean
  latencyMs     Int
  errorCode     String?
  healthScore   Int // 0-100 EMA
  sampledAt     DateTime @default(now())
  @@index([providerCode, sampledAt])
}

model ProviderCapability {
  id            String   @id @default(cuid())
  providerCode  String
  contract      String
  country       String
  currency      String
  service       String? // e.g. "BILL:ELECTRICITY" | "MOBILE_MONEY:MPESA"
  direction     String // INBOUND | OUTBOUND
  minAmountMinor Int
  maxAmountMinor Int
  feeBps        Int      @default(0)
  feeFixedMinor Int      @default(0)
  settleHours   Int      @default(0)
  enabled       Boolean  @default(true)
  @@index([contract, country, currency, enabled])
  @@index([providerCode])
}

model PaymentRoutingDecision {
  id            String   @id @default(cuid())
  transactionId String?
  contract      String
  providerCode  String
  chosenProvider String
  reason        String // scored | fallback | preferred | only_viable
  scoresJSON    String
  alternativesJSON String
  requestId     String
  createdAt     DateTime @default(now())
  @@index([transactionId])
  @@index([createdAt])
}

model PaymentFlowLog {
  id            String   @id @default(cuid())
  transactionId String?
  step          String // HOLD_DEBIT | PROVIDER_CALLED | CONFIRMED | AUTO_REVERSED
  status        String
  providerCode  String?
  payloadJSON   String?
  latencyMs     Int?
  at            DateTime @default(now())
  @@index([transactionId, at])
}

// --- Webhooks & events ---
model WebhookEvent {
  id            String   @id @default(cuid())
  providerCode  String
  eventId       String   @unique
  eventType     String
  payloadJSON   String
  signatureValid Boolean @default(false)
  processedAt   DateTime?
  transactionId String?
  createdAt     DateTime @default(now())
  @@index([providerCode, createdAt])
}

model WebhookEndpoint {
  id            String   @id @default(cuid())
  merchantId    String
  url           String
  secretHash    String
  eventsJSON    String   @default("[]")
  enabled       Boolean  @default(true)
  lastFailedAt  DateTime?
  consecutiveFailures Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([merchantId])
}

model OutboxEvent {
  id            String   @id @default(cuid())
  aggregateType String // TRANSACTION | USER | WALLET
  aggregateId   String
  type          String // PAYMENT_SETTLED | PAYMENT_REVERSED | PAYMENT_PENDING | FX_CONVERTED ...
  payloadJSON   String
  headersJSON   String   @default("{}")
  status        String   @default("PENDING") // PENDING | PUBLISHED | FAILED
  attempts      Int      @default(0)
  nextRetryAt   DateTime @default(now())
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  @@index([status, nextRetryAt])
  @@index([aggregateType, aggregateId])
}

model AsyncTask {
  id            String   @id @default(cuid())
  type          String // retry_provider_call | scheduled_payment | webhook_dispatch
  payloadJSON   String
  status        String   @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  attempts      Int      @default(0)
  maxAttempts   Int      @default(3)
  nextRetryAt   DateTime @default(now())
  lockedBy      String?
  lockedUntil   DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  @@index([status, nextRetryAt])
}

// --- Georouting & multi-currency ---
model CountryConfig {
  code          String   @id // NG | KE | GH | ZA | GB | US ...
  name          String
  currency      String // NGN | KES | GHS | ZAR | USD ...
  dialCode      String
  flagEmoji     String
  locale        String   @default("en") // en | sw | fr | pt | ar
  rtl           Boolean  @default(false)
  paymentMethodsJSON String @default("[]") // ["CARD","BANK_TRANSFER","USSD","MOBILE_MONEY","VIRTUAL_ACCOUNT"]
  billerCatalogKey String? // ng_baxi | ke_kplc
  kycRequirementsJSON String @default("{}")
  providersPreferredJSON String @default("{}")
  taxRateBps    Int      @default(0)
  regulatoryNotes String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CurrencyWallet {
  id            String   @id @default(cuid())
  userId        String
  currency      String // NGN | USD | EUR | GBP | KES | GHS | ZAR ...
  balanceMinor  Int      @default(0)
  status        String   @default("ACTIVE") // ACTIVE | FROZEN
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([userId, currency])
  @@index([userId])
}

model CurrencyLedgerEntry {
  id            String   @id @default(cuid())
  currencyWalletId String
  userId        String
  entryType     String // DEBIT | CREDIT
  amountMinor   Int
  currency      String
  refType       String
  refId         String?
  pairId        String?
  balanceAfterMinor Int
  description   String
  createdAt     DateTime @default(now())
  @@index([currencyWalletId])
  @@index([userId, createdAt])
}

model FxRateSnapshot {
  id            String   @id @default(cuid())
  base          String
  quote         String
  rate          Float
  source        String // paystack | flutterwave | wise | open-market
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime
  @@index([base, quote, fetchedAt])
}

model FxConfig {
  id            String   @id @default(cuid())
  base          String
  quote         String
  spreadBps     Int      @default(150)
  markupBps     Int      @default(50)
  feeFixedMinor Int      @default(0)
  feeBps        Int      @default(0)
  updatedAt     DateTime @updatedAt
  @@unique([base, quote])
}

// --- Merchant & payment links ---
model Merchant {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  apiKeyPrefix  String
  webhookSecretHash String
  status        String   @default("ACTIVE") // ACTIVE | SUSPENDED | CLOSED
  businessName  String?
  country       String   @default("NG")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MerchantApiKey {
  id            String   @id @default(cuid())
  merchantId    String
  keyHash       String   @unique
  prefix        String
  scopesJSON    String   @default("[]")
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime @default(now())
  @@index([merchantId])
}

model PaymentLink {
  id            String   @id @default(cuid())
  merchantId    String
  slug          String   @unique
  title         String
  amountMinor   Int?
  currency      String   @default("NGN")
  maxUses       Int      @default(0) // 0 = unlimited
  usesCount     Int      @default(0)
  expiresAt     DateTime?
  status        String   @default("ACTIVE") // ACTIVE | DISABLED | EXPIRED
  metadataJSON  String   @default("{}")
  createdAt     DateTime @default(now())
  @@index([merchantId])
}

model PaymentLinkPayment {
  id            String   @id @default(cuid())
  paymentLinkId String
  transactionId String?
  amountMinor   Int
  currency      String
  payerEmail    String?
  payerName     String?
  status        String   @default("PENDING") // PENDING | SUCCESS | FAILED
  reference     String   @unique
  createdAt     DateTime @default(now())
  @@index([paymentLinkId])
}

model SubscriptionPlan {
  id            String   @id @default(cuid())
  merchantId    String
  name          String
  amountMinor   Int
  currency      String
  interval      String // DAY | WEEK | MONTH | YEAR
  intervalCount Int      @default(1)
  trialDays     Int      @default(0)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  @@index([merchantId])
}

model Subscription {
  id            String   @id @default(cuid())
  planId        String
  customerId    String // userId
  status        String   @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELED | TRIALING
  currentPeriodEnd DateTime
  nextChargeAt  DateTime
  mandateId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([customerId])
  @@index([planId])
}

model Mandate {
  id            String   @id @default(cuid())
  userId        String
  merchantId    String
  providerRef   String?
  currency      String
  maxAmountMinor Int
  status        String   @default("ACTIVE") // ACTIVE | REVOKED
  revokedAt     DateTime?
  createdAt     DateTime @default(now())
  @@index([userId])
}

model ScheduledPayment {
  id            String   @id @default(cuid())
  userId        String
  type          String // TRANSFER | BILL | AIRTIME | DATA
  payloadJSON   String
  frequency     String // ONCE | DAILY | WEEKLY | MONTHLY
  nextRunAt     DateTime
  status        String   @default("ACTIVE") // ACTIVE | PAUSED | DONE | FAILED
  runCount      Int      @default(0)
  failCount     Int      @default(0)
  lastRunAt     DateTime?
  createdAt     DateTime @default(now())
  @@index([userId, nextRunAt])
  @@index([status, nextRunAt])
}

// --- Compliance ---
model SanctionsEntry {
  id            String   @id @default(cuid())
  listName      String // OFAC_SDN | UN_CONSOLIDATED | CBN_WATCHLIST
  entityType    String // INDIVIDUAL | ENTITY
