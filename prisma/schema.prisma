  country         String   // ISO code
  support         String   // FULL | LIMITED | BETA | CONFIGURABLE | DISABLED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([capabilityId, country])
  @@index([country, support])
}

/// Per-provider maturity per capability.
model CapabilityProviderSupport {
  id              String   @id @default(cuid())
  capabilityId    String
  capability      Capability @relation(fields: [capabilityId], references: [id])
  providerCode    String
  maturity        String   // NATIVE | SUPPORTED | LIMITED | BETA | PARKED | ROADMAP
  featuresJSON    String   @default("[]")
  version         String?
  countriesJSON   String   @default("[]")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([capabilityId, providerCode])
  @@index([providerCode, maturity])
}

/// Runtime feature flags per capability/scope/target.
model CapabilityFlag {
  id              String   @id @default(cuid())
  capabilityId    String
  capability      Capability @relation(fields: [capabilityId], references: [id])
  scope           String   // GLOBAL | COUNTRY | MERCHANT | USER_TIER | ENVIRONMENT | REGULATORY
  target          String   // country code / merchant id / tier / env
  enabled         Boolean  @default(true)
  reason          String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([capabilityId, scope, target])
  @@index([scope, target])
}

