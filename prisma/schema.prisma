// ===== Chapter 8: Event Store =====

/// Universal event store — every important event.
/// Supports replay and debugging. CQRS write model.
model EventStore {
  id              String   @id @default(cuid())
  eventType       String   // PAYMENT.CREATED, PAYMENT.COMPLETED, REFUND.CREATED, KYC.APPROVED
  aggregateType   String   // TRANSACTION | USER | MERCHANT | PROVIDER | SETTLEMENT
  aggregateId     String
  version         Int      @default(1) // aggregate version (for optimistic concurrency)
  payload         String   @default("{}") // JSON — immutable event payload
  metadata        String   @default("{}") // JSON — correlation ID, causation ID, actor
  status          String   @default("PENDING") // PENDING | PUBLISHED | FAILED
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  @@index([aggregateType, aggregateId, version])
  @@index([eventType, createdAt])
  @@index([status, createdAt])
}

