  quote           String
  rate            Float
  amountMinor     Int      // amount in base currency
  convertedMinor  Int      // amount in quote currency
  spreadBps       Int      @default(0)
  markupBps       Int      @default(0)
  status          String   @default("LOCKED") // LOCKED | EXPIRED | CONSUMED | CANCELLED
  expiresAt       DateTime
  consumedAt      DateTime?
  userId          String?
  merchantId      String?
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  @@index([base, quote, status])
  @@index([expiresAt])
  @@index([userId, createdAt])
}

/// Executed FX conversion records.
model FxTransaction {
  id              String   @id @default(cuid())
