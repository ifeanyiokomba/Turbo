  @@index([userId, createdAt])
  @@index([transactionId])
  @@index([base, quote, createdAt])
}

/// Tradable currency pair definitions.
model CurrencyPair {
  id              String   @id @default(cuid())
  base            String
  quote           String
  status          String   @default("ACTIVE") // ACTIVE | DISABLED
  minAmountMinor  Int      @default(0)
  maxAmountMinor  Int      @default(0)
  defaultSpreadBps Int     @default(150)
  defaultMarkupBps Int     @default(50)
