// ===== Disputes, Vouchers, Statements, Preferences (round 2) =====

model Dispute {
  id            String   @id @default(cuid())
  userId        String
  transactionId String?
  subject       String
  category      String   @default("TRANSACTION") // TRANSACTION | BILL | TRANSFER | CARD | AIRTIME | OTHER
  priority      String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status        String   @default("OPEN") // OPEN | UNDER_REVIEW | EVIDENCE_REQUIRED | RESOLVED_FAVOUR_USER | RESOLVED_FAVOUR_PLATFORM | CLOSED | ESCALATED
  description   String
  resolution    String?
  assignedTo    String?
  messages      DisputeMessage[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  resolvedAt    DateTime?
  @@index([userId, createdAt])
  @@index([status])
}

model DisputeMessage {
  id            String   @id @default(cuid())
  disputeId     String
  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId      String
  senderRole    String   @default("USER") // USER | ADMIN
  message       String
  attachmentsJSON String @default("[]")
  createdAt     DateTime @default(now())
  @@index([disputeId, createdAt])
}

model Voucher {
  id            String   @id @default(cuid())
  code          String   @unique
  type          String   @default("CASHBACK") // CASHBACK | DISCOUNT | FEE_WAIVER | PERCENT_OFF | FLAT_OFF
  valueKobo     Int      @default(0) // flat amount for CASHBACK/FLAT_OFF
  percentOff    Int      @default(0) // for PERCENT_OFF
  description   String
  minAmountKobo Int      @default(0)
  maxRedemptions Int     @default(0) // 0 = unlimited
  redemptionsCount Int   @default(0)
  perUserLimit  Int      @default(1)
  validFrom     DateTime @default(now())
  validUntil    DateTime?
  status        String   @default("ACTIVE") // ACTIVE | EXPIRED | DISABLED
  createdById   String?
  createdAt     DateTime @default(now())
  redemptions   VoucherRedemption[]
}

model VoucherRedemption {
  id            String   @id @default(cuid())
  voucherId     String
  voucher       Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId        String
  transactionId String?
  valueAppliedKobo Int
  status        String   @default("SUCCESS") // SUCCESS | FAILED
  createdAt     DateTime @default(now())
  @@unique([voucherId, userId])
  @@index([userId])
}

model StatementRequest {
  id            String   @id @default(cuid())
  userId        String
  periodStart   DateTime
  periodEnd     DateTime
  format        String   @default("PDF") // PDF | CSV
  status        String   @default("PENDING") // PENDING | READY | FAILED
  filePath      String?
  createdAt     DateTime @default(now())
  @@index([userId, createdAt])
}

model CommunicationPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  emailEnabled  Boolean  @default(true)
  smsEnabled    Boolean  @default(true)
  pushEnabled   Boolean  @default(true)
  whatsappEnabled Boolean @default(false)
  transactionAlerts Boolean @default(true)
  securityAlerts Boolean @default(true)
  marketingAlerts Boolean @default(false)
  weeklySummary Boolean @default(true)
  updatedAt     DateTime @updatedAt
}

model TeamMember {
  id            String   @id @default(cuid())
  email         String   @unique
  fullName      String
  role          String   @default("SUPPORT") // ADMIN | COMPLIANCE | SUPPORT | FINANCE
  status        String   @default("PENDING") // PENDING | ACTIVE | DEACTIVATED
  invitedById   String
  invitedAt     DateTime @default(now())
  activatedAt   DateTime?
  deactivatedAt DateTime?
  lastLoginAt   DateTime?
  @@index([status])
}

model SpendingBudget {
  id            String   @id @default(cuid())
  userId        String
  category      String   @default("TOTAL") // TOTAL | TRANSFER | AIRTIME | DATA | BILL | CARD_FUND
  monthlyLimitKobo Int
  periodStart   DateTime @default(now())
  alertThreshold Int     @default(80) // % at which to alert
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([userId, category])
  @@index([userId])
}

model UserBadge {
  id            String   @id @default(cuid())
  userId        String
  badgeKey      String   @unique // FIRST_TRANSFER | FIRST_FUNDING | FIRST_AIRTIME | FIRST_BILL | FIRST_CARD | FIRST_SAVINGS | FIRST_INVESTMENT | KYC_VERIFIED | PIN_SET | SAVVY_SAVER | BIG_SPENDER | EARLY_BIRD | REFERRAL_PRO | SECURE_USER
  earnedAt      DateTime @default(now())

  @@unique([userId, badgeKey])
  @@index([userId])
}

model TransferTemplate {
  id            String   @id @default(cuid())
  userId        String
  name          String
  type          String   @default("BANK") // BANK | TURBOPAY
  recipientName String
  accountNumber String
  bankCode      String?
  bankName      String?
  amountKobo    Int?
  note          String?
  isFavorite    Boolean  @default(false)
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model MarketplaceMerchant {
  id            String   @id @default(cuid())
  name          String
  category      String   @default("SHOPPING") // SHOPPING | FOOD | TRANSPORT | UTILITIES | ENTERTAINMENT | HEALTH | EDUCATION | TRAVEL
  description   String
  logoUrl       String?
  website       String?
  phone         String?
  email         String?
  address       String?
  rating        Float    @default(4.5)
  reviewCount   Int      @default(0)
  verified      Boolean  @default(false)
  featured      Boolean  @default(false)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  @@index([category, status])
  @@index([featured])
}

model MerchantReview {
  id            String   @id @default(cuid())
  merchantId    String
  userId        String
  rating        Int      // 1-5
  comment       String?
  status        String   @default("PUBLISHED") // PUBLISHED | HIDDEN
  createdAt     DateTime @default(now())
  @@unique([merchantId, userId])
  @@index([merchantId, status])
}

// ===== MiniPay / Celo integration =====

model CeloWallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  address       String   @unique // 0x... EIP-55 checksum
  chainId       Int      @default(42220) // 42220 mainnet | 11142220 sepolia
  linkedAt      DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  metadata      String? // JSON: phone, ens, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  transactions  OnChainTransaction[]
  @@index([userId])
}

model OnChainTransaction {
  id                String   @id @default(cuid())
  userId            String
  celoWalletId      String
  celoWallet        CeloWallet @relation(fields: [celoWalletId], references: [id], onDelete: Cascade)
  hash              String   @unique // tx hash, idempotency key
  type              String // DEPOSIT | WITHDRAW | PAYMENT | SWAP
  direction         String // CREDIT | DEBIT
  tokenSymbol       String // USDm | USDC | USDT | NGNm | CELO
  tokenAddress      String // 0x... ERC-20 contract
  amountHuman       String // "10.5" (display)
  amountWei         String // "10500000000000000000" (raw)
  amountKoboEquiv   Int? // NGN equivalent in kobo (for ledger linkage)
  counterpartyAddress String
  status            String   @default("PENDING") // PENDING | SUCCESS | FAILED | REVERSED
  blockNumber       BigInt?
  gasUsed           BigInt?
  feeCurrency       String?
  metadata          String? // JSON
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([userId, createdAt])
  @@index([celoWalletId])
  @@index([status])
  @@index([hash])
}

model CeloBridgeEvent {
  id                String   @id @default(cuid())
  userId            String
  onchainTxId       String   @unique
  direction         String // NGN_TO_CUSD | CUSD_TO_NGN
  status            String   @default("PENDING") // PENDING | COMPLETED | REVERSED
  amountKobo        Int
  amountUsdm        String
  fxRate            Float
  createdAt         DateTime @default(now())
  completedAt       DateTime?
  @@index([userId, createdAt])
}

model CeloTokenConfig {
  id            String   @id @default(cuid())
  symbol        String // USDm | USDC | USDT | NGNm | CELO (not globally unique — same symbol on mainnet + testnet)
  address       String // 0x... (unique per chain, but may repeat across chains)
  decimals      Int // 18 | 6
  chainId       Int // 42220 | 11142220
  isActive      Boolean  @default(true)
  isBridgeable  Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([symbol, chainId])
  @@index([chainId, isActive])
}

// ===== Passkeys (WebAuthn) + MFA =====

model Passkey {
  id            String   @id @default(cuid())
  userId        String
  credentialId  String   @unique // base64url
  publicKey     String   // base64
  counter       Int      @default(0)
  deviceName    String?
  deviceType    String   @default("unknown") // platform | cross-platform
  transports    String   @default("[]") // JSON array
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime?
  @@index([userId])
}

model MfaSecret {
  id            String   @id @default(cuid())
  userId        String   @unique
  secretEnc     String   // AES-256-GCM encrypted TOTP secret
  enabled       Boolean  @default(false)
  backupCodesHash String @default("[]") // JSON array of hashed codes
  enabledAt     DateTime?
  createdAt     DateTime @default(now())
  @@index([userId])
}

// ===== Device tracking + OAuth social login =====

model Device {
  id            String   @id @default(cuid())
  userId        String
  fingerprint   String   // SHA-256 of UA + /24 subnet
  deviceName    String?
  deviceType    String   @default("unknown") // desktop | mobile | tablet
  os            String?
  browser       String?
  ip            String?
  trusted       Boolean  @default(false)
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  @@unique([userId, fingerprint])
  @@index([userId])
}

model OAuthAccount {
  id            String   @id @default(cuid())
  userId        String
  provider      String   @unique // google | apple | microsoft
  providerAccountId String @unique
  email         String?
  name          String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  @@index([userId])
}

model RefreshToken {
  id            String   @id @default(cuid())
  userId        String
  tokenHash     String   @unique // SHA-256 of refresh token
  expiresAt     DateTime
  revokedAt     DateTime?
  userAgent     String?
  ip            String?
  deviceId      String?
  createdAt     DateTime @default(now())
  @@index([userId])
  @@index([tokenHash])
}

// ===== Phase 8: Transaction Event Engine (immutable append-only) =====

model TransactionEvent {
  id            String   @id @default(cuid())
  transactionId String
  eventType     String   // CREATED | AUTHORIZED | PROCESSING | SETTLED | COMPLETED | FAILED | REVERSED | REFUNDED
  status        String   // PENDING | SUCCESS | FAILED
  actor         String   @default("SYSTEM") // SYSTEM | USER | ADMIN | PROVIDER
  actorId       String?
  payload       String   @default("{}") // JSON — immutable snapshot at this point
  metadata      String   @default("{}") // JSON — additional context
  createdAt     DateTime @default(now())
  @@index([transactionId, createdAt])
  @@index([eventType])
}

// ===== Chapter 5: Financial Ledger Engine (FLE) =====

model LedgerAccount {
  id            String   @id @default(cuid())
  code          String   @unique // e.g., "PAYSTACK_CLEARING", "FEE_REVENUE", "CUST_WALLET_NGN_userId"
  name          String
  type          String   // ASSET | LIABILITY | REVENUE | EXPENSE
  subType       String   // CASH | PROVIDER_CLEARING | CUSTOMER_WALLET | MERCHANT_WALLET | FEE_REVENUE | TAX_HOLDING | FX_REVENUE | CHARGEBACK_RESERVE | OPERATIONAL_RESERVE
  currency      String   @default("NGN")
  ownerId       String?  // userId or merchantId or providerCode
  providerCode  String?  // for provider clearing accounts
  availableBalance Int   @default(0)
  pendingBalance  Int    @default(0)
  reservedBalance Int    @default(0)
  settlementBalance Int @default(0)
  feeBalance      Int    @default(0)
  status        String   @default("ACTIVE") // ACTIVE | FROZEN | CLOSED
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  entries       JournalEntry[]
  @@index([type, subType])
  @@index([ownerId])
  @@index([providerCode])
}

model JournalEntry {
  id            String   @id @default(cuid())
  journalType   String   // DEPOSIT | WITHDRAWAL | TRANSFER | REFUND | REVERSAL | SETTLEMENT | CHARGEBACK | FEE | FX | ESCROW | INTEREST | ADJUSTMENT
  accountId     String
  account       LedgerAccount @relation(fields: [accountId], references: [id])
  transactionId String?
  reference     String
  currency      String
  amount        Int      // always positive
  debitCredit   String   // DEBIT | CREDIT
  pairId        String?  // links the debit+credit pair
  source        String?  // origin: PROVIDER | USER | SYSTEM | ADMIN
  destination   String?  // target account code
  provider      String?
  status        String   @default("POSTED") // POSTED | PENDING | REVERSED
  accountingPeriodId String?
  metadata      String?  // JSON
  createdAt     DateTime @default(now())
  @@index([accountId, createdAt])
  @@index([transactionId])
  @@index([journalType])
  @@index([pairId])
}

model BalanceSnapshot {
  id            String   @id @default(cuid())
  accountId     String
  currency      String
  availableBalance Int
  pendingBalance  Int
  reservedBalance Int
  settlementBalance Int
  feeBalance      Int
  snapshotDate  DateTime
  createdAt     DateTime @default(now())
  @@unique([accountId, snapshotDate])
  @@index([snapshotDate])
}

model AccountingPeriod {
  id            String   @id @default(cuid())
  name          String   // "2026-07" or "2026-07-25"
  type          String   // DAILY | MONTHLY | FISCAL_YEAR
  startDate     DateTime
  endDate       DateTime
  status        String   @default("OPEN") // OPEN | CLOSED | LOCKED
  closedAt      DateTime?
  closedBy      String?
  createdAt     DateTime @default(now())
  @@unique([type, startDate])
}

model ReconciliationRun {
  id            String   @id @default(cuid())
  providerCode  String?
  periodStart   DateTime
  periodEnd     DateTime
  source        String   // PROVIDER_REPORT | BANK_STATEMENT | SETTLEMENT_REPORT
  totalChecked  Int      @default(0)
  matched       Int      @default(0)
  missing       Int      @default(0)
  duplicate     Int      @default(0)
  amountMismatch Int     @default(0)
  currencyMismatch Int   @default(0)
  referenceMismatch Int  @default(0)
  settlementDelay Int    @default(0)
  feeDifference Int      @default(0)
  status        String   @default("PENDING") // PENDING | COMPLETED | ALERT
  metadata      String?  // JSON
  createdAt     DateTime @default(now())
  @@index([providerCode, periodStart])
}

// =========================================================================
// CHAPTER 8: TurboCore Universal Data Platform
// =========================================================================
//
// The database is divided into bounded domains. Each domain owns its tables.
// Every financial object has a prefixed public ID (usr_, txn_, wal_, etc.).
// Soft delete only — never DELETE financial records.
//
// The models below fill the gaps identified in the Chapter 8 domain catalog.
// They complement the 85 existing models to complete the 14-domain architecture.

// ===== Chapter 8: Payment Domain (normalized payment history) =====

/// Refund records — linked to original transaction. Supports full + partial.
model Refund {
  id              String   @id @default(cuid())
  transactionId   String
  reference       String   @unique
  amountMinor     Int      // refund amount in kobo
  currency        String
  type            String   @default("FULL") // FULL | PARTIAL
  status          String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | REVERSED
  providerCode    String?
  providerRef     String?  // provider's refund reference
  reason          String?
  initiatedBy     String   @default("SYSTEM") // SYSTEM | USER | ADMIN | MERCHANT
  initiatedById   String?
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  processedAt     DateTime?
  @@index([transactionId, status])
  @@index([reference])
  @@index([status, createdAt])
}

/// Card scheme chargeback records.
model Chargeback {
  id              String   @id @default(cuid())
  transactionId   String
  reference       String   @unique
  chargebackRef   String?  // provider's chargeback reference
  amountMinor     Int
  currency        String
  reason          String   // FRAUD | DUPLICATE | PRODUCT_NOT_RECEIVED | CREDIT_NOT_PROCESSED | OTHER
  reasonCode      String?
  status          String   @default("OPEN") // OPEN | UNDER_REVIEW | ACCEPTED | CONTESTED | WON | LOST | CLOSED
  providerCode    String?
  evidenceJSON    String   @default("[]") // JSON array of evidence docs
  challengedAt    DateTime?
  resolvedAt      DateTime?
  resolvedBy      String?
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([transactionId, status])
  @@index([reference])
  @@index([status, createdAt])
}

/// Per-attempt records for retried payments.
model PaymentAttempt {
  id              String   @id @default(cuid())
  transactionId   String
  attemptNumber   Int      @default(1)
  providerCode    String
  providerRef     String?
  status          String   @default("PENDING") // PENDING | SUCCESS | FAILED | TIMEOUT | RETRYING
  amountMinor     Int
  currency        String
  errorCode       String?
  errorMessage    String?
  latencyMs       Int?
  requestPayload  String   @default("{}") // JSON — sanitized (no PAN)
  responsePayload String   @default("{}") // JSON
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  @@index([transactionId, attemptNumber])
  @@index([status, startedAt])
  @@index([providerCode, startedAt])
}

/// Saved payment methods — tokenized cards, bank accounts.
model PaymentMethod {
  id              String   @id @default(cuid())
  userId          String
  type            String   // CARD | BANK_ACCOUNT | MOBILE_MONEY | USSD
  providerToken   String   // provider's tokenized reference
  providerCode    String
  // Card fields (when type=CARD)
  brand           String?  // VISA | MASTERCARD | VERVE
  last4           String?
  expMonth        Int?
  expYear         Int?
  // Bank fields (when type=BANK_ACCOUNT)
  bankCode        String?
  bankName        String?
  accountNumber   String?  // masked
  accountName     String?
  // Mobile money fields
  msisdn          String?  // masked
  mmProvider      String?
  isDefault       Boolean  @default(false)
  status          String   @default("ACTIVE") // ACTIVE | EXPIRED | DELETED
  deletedAt       DateTime?
  deletedBy       String?
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([userId, type, status])
  @@index([providerCode, providerToken])
}

// ===== Chapter 8: Capability Domain (GCR persistence layer) =====

/// 22 capability groups — Collections, Disbursements, Wallets, etc.
model CapabilityGroup {
  id              String   @id // e.g. "collections", "disbursements"
  name            String
  description     String
  domain          String   @default("PAYMENTS")
  icon            String
  accent          String
  order           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  capabilities    Capability[]
}

/// 205 capabilities — the GCR catalogue persisted.
model Capability {
  id              String   @id // e.g. "collections.cards"
  name            String
  description     String
  groupId         String
  group           CapabilityGroup @relation(fields: [groupId], references: [id])
  direction       String   // INBOUND | OUTBOUND | BOTH | NEUTRAL
  status          String   @default("STABLE") // STABLE | BETA | EXPERIMENTAL | DEPRECATED | PLANNED
  countriesJSON   String   @default("[]") // JSON array
  currenciesJSON  String   @default("[]")
  requiredKycTier Int      @default(0)
  supportsRecurring  Boolean @default(false)
  supportsRefunds    Boolean @default(false)
  supportsChargeback Boolean @default(false)
  supportsPartial    Boolean @default(false)
  supportsSplit      Boolean @default(false)
  featuresJSON    String   @default("[]")
  documentationJSON String  @default("{}")
  tagsJSON        String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  deletedBy       String?
  dependencies    CapabilityDependency[] @relation("FromCap")
  dependents      CapabilityDependency[] @relation("ToCap")
  versions        CapabilityVersion[]
  countrySupport  CapabilityCountrySupport[]
  providerSupport CapabilityProviderSupport[]
  flags           CapabilityFlag[]
  @@index([groupId, status])
  @@index([direction, status])
}

/// Knowledge graph edges — REQUIRES / RECOMMENDS / OPTIONAL.
model CapabilityDependency {
  id              String   @id @default(cuid())
  capabilityId    String
  dependencyId    String
  kind            String   // REQUIRES | RECOMMENDS | OPTIONAL
  reason          String?
  capability      Capability @relation("FromCap", fields: [capabilityId], references: [id])
  dependency      Capability @relation("ToCap", fields: [dependencyId], references: [id])
  createdAt       DateTime @default(now())
  @@unique([capabilityId, dependencyId])
  @@index([dependencyId])
}

/// Versioned capability definitions.
model CapabilityVersion {
  id              String   @id @default(cuid())
  capabilityId    String
  capability      Capability @relation(fields: [capabilityId], references: [id])
  version         String   // "v1", "v2", "v3"
  label           String
  releaseNotes    String?
  status          String   @default("STABLE")
  isCurrent       Boolean  @default(false)
