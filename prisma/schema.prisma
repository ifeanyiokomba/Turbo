// ===== Chapter 8: Risk Domain =====

/// Per-entity risk scores (transaction or user).
model RiskScore {
  id              String   @id @default(cuid())
  entityType      String   // TRANSACTION | USER | MERCHANT
  entityId        String
  score           Int      // 0-100
  level           String   // LOW | MEDIUM | HIGH | CRITICAL
  factorsJSON     String   @default("[]") // contributing factors
  evaluatedAt     DateTime @default(now())
  @@index([entityType, entityId, evaluatedAt])
  @@index([level, evaluatedAt])
}

/// Risk engine evaluation events.
model RiskEvent {
  id              String   @id @default(cuid())
  entityType      String
  entityId        String
  ruleId          String?
  ruleName        String?
  action          String   // ALLOW | REVIEW | BLOCK
  score           Int?
  detailsJSON     String   @default("{}")
  createdAt       DateTime @default(now())
