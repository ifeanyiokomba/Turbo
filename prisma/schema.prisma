  @@index([channel, status])
}

/// Per-message delivery logs.
model DeliveryLog {
  id              String   @id @default(cuid())
  notificationId  String?
  channel         String   // EMAIL | SMS | PUSH | IN_APP
  recipient       String   // email/phone/device-token/userId
  status          String   @default("PENDING") // PENDING | SENT | DELIVERED | FAILED | BOUNCED
  providerCode    String?
  providerRef     String?
  attempts        Int      @default(0)
  errorCode       String?
  errorMessage    String?
  sentAt          DateTime?
  deliveredAt     DateTime?
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  @@index([notificationId, status])
  @@index([channel, status, createdAt])
  @@index([recipient, createdAt])
}

