# =============================================================================
# Turbopay — Environment configuration template
# =============================================================================
# Copy to `.env` and fill in real values before deploying.
#   cp .env.example .env
#
# Secrets generation:
#   openssl rand -hex 32    # for JWT_SECRET, SESSION_SECRET, CRON_SECRET
# =============================================================================

# ---- Database --------------------------------------------------------------
# SQLite for local dev (default). PostgreSQL for production / docker-compose.
DATABASE_URL="file:./db/custom.db"
# Production (docker-compose): postgresql://turbopay:turbopay@postgres:5432/turbopay?schema=public

# ---- Auth ------------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=""
# REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# ---- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

# ---- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins for browser requests.
ALLOWED_ORIGINS="http://localhost:3000"

# ---- Sentry (optional) -----------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ---- Rate limiting / caching (optional) ------------------------------------
# Redis URL for distributed rate limiting. Falls back to in-memory when unset.
REDIS_URL=""

# ---- Payment providers (all optional) --------------------------------------
# The app runs in sandbox / mock mode when these are unset. Configure live keys
# via the Admin Console → Providers → Rotate Credentials (stored encrypted in DB).
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_USER_ID=""
MTN_MOMO_API_KEY=""
AIRTEL_MONEY_CLIENT_ID=""
AIRTEL_MONEY_CLIENT_SECRET=""
SMARTCASH_API_KEY=""
SMARTCASH_MERCHANT_ID=""
PAGA_API_KEY=""
PAGA_PUBLIC_KEY=""
PAGA_SECRET_KEY=""
BAXI_API_KEY=""
REMITA_MERCHANT_ID=""
REMITA_API_KEY=""
REMITA_API_TOKEN=""
QUICKTELLER_CLIENT_ID=""
QUICKTELLER_SECRET_KEY=""

# ---- KYC -------------------------------------------------------------------
DOJAH_APP_ID=""
DOJAH_PRIVATE_KEY=""

# ---- Notifications ---------------------------------------------------------
TERMII_API_KEY=""
RESEND_API_KEY=""

# ---- International transfers ----------------------------------------------
WISE_API_TOKEN=""
STRIPE_SECRET_KEY=""

# ---- Treasury (Celo / blockchain — dormant) -------------------------------
TURBOPAY_TREASURY_PRIVATE_KEY=""
TURBOPAY_TREASURY_ADDRESS=""

# ---- WebAuthn (passkeys) ---------------------------------------------------
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Turbopay"

# ---- Cron ------------------------------------------------------------------
# REQUIRED — protects /api/cron/* endpoints. Generate with: openssl rand -hex 32
# Cron jobs send this as `x-cron-secret` header.
CRON_SECRET=""

# ---- Docker Compose (Postgres) — used by docker-compose.yml ----------------
POSTGRES_DB="turbopay"
POSTGRES_USER="turbopay"
POSTGRES_PASSWORD="turbopay"

# ---- Caddy (production reverse proxy) --------------------------------------
# Your production domain, e.g. turbopay.example.com
DOMAIN=""
