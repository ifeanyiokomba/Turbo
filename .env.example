# =============================================================================
# Turbopay — Environment configuration template
# =============================================================================
# Copy to `.env` and fill in real values before deploying.
#   cp .env.example .env
#
# Secrets generation:
#   openssl rand -hex 32    # for JWT_SECRET, SESSION_SECRET, CRON_SECRET
#
# For Vercel deployment, set these in:
#   Vercel Dashboard → Project → Settings → Environment Variables
# =============================================================================

# ---- Database --------------------------------------------------------------
# Neon PostgreSQL (recommended — free serverless PostgreSQL)
# Create at: https://neon.tech → New Project → Copy connection string
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/turbopay?sslmode=require"

# ---- Auth ------------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=""
# REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# ---- Google OAuth (social login) ------------------------------------------
# Register at: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-app.vercel.app/api/auth/google/callback"

# ---- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NODE_ENV="production"
PORT=3000

# ---- CORS ------------------------------------------------------------------
ALLOWED_ORIGINS="https://your-app.vercel.app"

# ---- Sentry (optional) -----------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ---- Rate limiting / caching (optional) ------------------------------------
REDIS_URL=""

# ---- Payment providers (all optional) --------------------------------------
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_USER_ID=""
MTN_MOMO_API_KEY=""
AIRTEL_MONEY_CLIENT_ID=""
AIRTEL_MONEY_CLIENT_SECRET=""
SMARTCASH_API_KEY=""
SMARTCASH_MERCHANT_ID=""
PAGA_API_KEY=""
PAGA_PUBLIC_KEY=""
PAGA_SECRET_KEY=""
BAXI_API_KEY=""
REMITA_MERCHANT_ID=""
REMITA_API_KEY=""
REMITA_API_TOKEN=""
QUICKTELLER_CLIENT_ID=""
QUICKTELLER_SECRET_KEY=""

# ---- KYC -------------------------------------------------------------------
DOJAH_APP_ID=""
DOJAH_PRIVATE_KEY=""

# ---- Notifications ---------------------------------------------------------
TERMII_API_KEY=""
RESEND_API_KEY=""

# ---- International transfers ----------------------------------------------
WISE_API_TOKEN=""
STRIPE_SECRET_KEY=""

# ---- Treasury (Celo / blockchain — dormant) -------------------------------
TURBOPAY_TREASURY_PRIVATE_KEY=""
TURBOPAY_TREASURY_ADDRESS=""

# ---- WebAuthn (passkeys) ---------------------------------------------------
# For Vercel: set to your Vercel domain (e.g. turbopay.vercel.app)
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Turbopay"

# ---- Cron ------------------------------------------------------------------
# REQUIRED — protects /api/cron/* endpoints. Generate with: openssl rand -hex 32
CRON_SECRET=""

# ---- Vercel-specific -------------------------------------------------------
# TEB signing key for Event Bus (generate with: openssl rand -hex 32)
TEB_SIGNING_KEY=""
